# --- Laravel (Backend) ---
/backend/vendor/
/backend/node_modules/
/backend/.env
/backend/storage/*.key
/backend/public/hot
/backend/public/temp/
/backend/.phpunit.result.cache

# Security: Ignore user photos but keep the directory structure
/backend/storage/app/public/photos/*
!/backend/storage/app/public/photos/.gitignore

# --- React (Frontend) ---
/frontend/node_modules/
/frontend/dist/
/frontend/.env
/frontend/.env.local

# --- Python (AI Engine) ---
/ai_engine/venv/
/ai_engine/__pycache__/
/ai_engine/*.pyc
/ai_engine/.env

# Security: Ignore the dataset and the trained brain
/ai_engine/dataset/*
!/ai_engine/dataset/.gitignore
/ai_engine/trainer.yml

# --- Temporary Files (Camera Uploads) ---
# These are generated by the controller during checks
*.jpg
*.png
temp_check_*.jpg
temp_recognition_*.jpg

# --- General System Files ---
.DS_Store
Thumbs.db
.vscode/
*.whl